def search_oriented_two_vertex_graphs(
    incoming: Iterable[str],
    outgoing: Iterable[str],
) -> tuple[TreeTopologyCandidate, ...]:
    """
    Backwards-compatible wrapper.

    IMPORTANT:
    This function now uses the same general graph engine, restricted
    to exactly two vertices for callers that still use the old API.
    """
    all_candidates = search_tree_topologies(
        incoming,
        outgoing,
        max_vertices=2,
    )

    return tuple(
        candidate
        for candidate in all_candidates
        if len(candidate.vertices) == 2
    )


def oriented_graph_summary(
    incoming: Iterable[str],
    outgoing: Iterable[str],
    *,
    max_vertices: int = 4,
):
    candidates = search_tree_topologies(
        incoming,
        outgoing,
        max_vertices=max_vertices,
    )

    return {
        "process": _process_string(
            tuple(_normalize_particle(x) for x in incoming),
            tuple(_normalize_particle(x) for x in outgoing),
        ),
        "candidate_count": len(candidates),
        "candidates": [
            {
                "candidate_id": candidate.candidate_id,
                "topology": candidate.topology,
                "vertices": [
                    {
                        "instance_id": vertex.instance_id,
                        "catalog_vertex_id": vertex.catalog_vertex_id,
                        "particles": list(vertex.particles),
                        "theory": vertex.theory,
                    }
                    for vertex in candidate.vertices
                ],
                "external_attachments": [
                    {
                        "leg_id": attachment.leg_id,
                        "vertex_instance": attachment.vertex_instance,
                        "physical_particle": attachment.physical_particle,
                        "crossed_field": attachment.crossed_field,
                        "role": attachment.role,
                    }
                    for attachment in candidate.external_attachments
                ],
                "internal_propagators": [
                    {
                        "line_id": propagator.line_id,
                        "particle": propagator.particle,
                        "field_type": propagator.field_type,
                        "vertex_a": propagator.vertex_a,
                        "vertex_b": propagator.vertex_b,
                        "orientation": propagator.orientation,
                    }
                    for propagator in candidate.internal_propagators
                ],
                "fermion_lines": [
                    {
                        "line_id": line.line_id,
                        "family": line.family,
                        "incoming_leg": line.incoming_leg,
                        "outgoing_leg": line.outgoing_leg,
                        "start_vertex": line.start_vertex,
                        "end_vertex": line.end_vertex,
                        "orientation": line.orientation,
                    }
                    for line in candidate.fermion_lines
                ],
                "status": candidate.status,
                "reason": candidate.reason,
            }
            for candidate in candidates
        ],
    }
